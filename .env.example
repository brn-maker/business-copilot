# Coffee Analytics Copilot - Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenRouter API Key (required)
# Get free API key at: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Specific LLM models (if you want to override defaults)
# Default: haiku for fast models, sonnet for synthesis
# FAST_MODEL_ID=meta-llama/llama-3.1-70b-instruct
# SYNTHESIS_MODEL_ID=anthropic/claude-3.5-sonnet

# Optional: Application settings
APP_DEBUG=false
DATA_CACHE_DIR=./data_cache
MODELS_DIR=./models
