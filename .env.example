# Coffee Analytics Copilot - Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenRouter API Key (required)
# Get free API key at: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: model keys from utils/model_router.py (defaults to openrouter/free)
# FAST_MODEL_KEY=auto
# SYNTHESIS_MODEL_KEY=auto
# Keys: auto, llama, gemma, nemotron, gpt_oss / llama_large, gemma_pro, qwen
# Optional: Application settings
APP_DEBUG=false
DATA_CACHE_DIR=./data_cache
MODELS_DIR=./models
